không tự chủ"}, {"id": "text-90", "original": "Đau sau khi ngã", "value": "Đau sau khi ngã"}, {"id": "text-91", "original": "Xương cùng và xương cụt", "value": "Xương cùng và xương cụt"}, {"id": "text-92", "original": "Phần cuối cột sống, nối với khung chậu", "value": "Phần cuối cột sống, nối với khung chậu"}, {"id": "text-93", "original": "Xương cùng nối cột sống với khung chậu. Xương cụt là đoạn nhỏ ở cuối cùng.", "value": "Xương cùng nối cột sống với khung chậu. Xương cụt là đoạn nhỏ ở cuối cùng."}, {"id": "text-94", "original": "Đau vùng mông hoặc xương cụt khi ngồi lâu", "value": "Đau vùng mông hoặc xương cụt khi ngồi lâu"}, {"id": "text-95", "original": "Ngồi đệm mỏng, mềm vừa", "value": "Ngồi đệm mỏng, mềm vừa"}, {"id": "text-96", "original": "Đứng dậy và đi lại sau mỗi 45 đến 60 phút", "value": "Đứng dậy và đi lại sau mỗi 45 đến 60 phút"}, {"id": "text-97", "original": "Đổi tư thế, không ngồi lệch một bên", "value": "Đổi tư thế, không ngồi lệch một bên"}, {"id": "text-98", "original": "Đau dữ dội sau ngã", "value": "Đau dữ dội sau ngã"}, {"id": "text-99", "original": "Đau không giảm dù đã đổi tư thế", "value": "Đau không giảm dù đã đổi tư thế"}, {"id": "text-100", "original": "Xương khớp", "value": "Xương khớp"}, {"id": "text-101", "original": "Chạm vào chấm sáng để xem từng khớp", "value": "Chạm vào chấm sáng để xem từng khớp"}, {"id": "text-102", "original": "Khớp vai", "value": "Khớp vai"}, {"id": "text-103", "original": "Nơi cánh tay nối với thân", "value": "Nơi cánh tay nối với thân"}, {"id": "text-104", "original": "Khớp vai cử động rất rộng nên dễ bị mỏi, đau khi làm việc tay cao hoặc gánh nặng.", "value": "Khớp vai cử động rất rộng nên dễ bị mỏi, đau khi làm việc tay cao hoặc gánh nặng."}, {"id": "text-105", "original": "Đau khi giơ tay hoặc với ra sau", "value": "Đau khi giơ tay hoặc với ra sau"}, {"id": "text-106", "original": "Cứng vai buổi sáng", "value": "Cứng vai buổi sáng"}, {"id": "text-107", "original": "Khó cài áo, chải đầu", "value": "Khó cài áo, chải đầu"}, {"id": "text-108", "original": "Xoay vai nhẹ nhàng mỗi ngày", "value": "Xoay vai nhẹ nhàng mỗi ngày"}, {"id": "text-109", "original": "Không gánh, xách nặng", "value": "Không gánh, xách nặng"}, {"id": "text-110", "original": "Chườm ấm trước khi tập", "value": "Chườm ấm trước khi tập"}, {"id": "text-111", "original": "Không nâng nổi tay", "value": "Không nâng nổi tay"}, {"id": "text-112", "original": "Đau về đêm làm mất ngủ", "value": "Đau về đêm làm mất ngủ"}, {"id": "text-113", "original": "Khớp háng", "value": "Khớp háng"}, {"id": "text-114", "original": "Nơi đùi nối với khung chậu", "value": "Nơi đùi nối với khung chậu"}, {"id": "text-115", "original": "Khớp háng đỡ cả sức nặng khi đứng và đi. Sụn mòn theo tuổi gây đau khi đứng lên, bước đi.", "value": "Khớp háng đỡ cả sức nặng khi đứng và đi. Sụn mòn theo tuổi gây đau khi đứng lên, bước đi."}, {"id": "text-116", "original": "Đau vùng bẹn hoặc mông", "value": "Đau vùng bẹn hoặc mông"}, {"id": "text-117", "original": "Đứng lên khỏi ghế khó, cứng khớp", "value": "Đứng lên khỏi ghế khó, cứng khớp"}, {"id": "text-118", "original": "Bước đi đau, đi cà nhắc", "value": "Bước đi đau, đi cà nhắc"}, {"id": "text-119", "original": "Dùng ghế cao vừa tầm, có tay vịn", "value": "Dùng ghế cao vừa tầm, có tay vịn"}, {"id": "text-120", "original": "Đi bộ chậm trên nền phẳng", "value": "Đi bộ chậm trên nền phẳng"}, {"id": "text-121", "original": "Giữ cân nặng hợp lý", "value": "Giữ cân nặng hợp lý"}, {"id": "text-122", "original": "Đau tăng nhanh, đi lại khó", "value": "Đau tăng nhanh, đi lại khó"}, {"id": "text-123", "original": "Đau dữ dội sau ngã: không tự dậy, gọi người giúp hoặc 115", "value": "Đau dữ dội sau ngã: không tự dậy, gọi người giúp hoặc 115"}, {"id": "text-124", "original": "Khớp gối", "value": "Khớp gối"}, {"id": "text-125", "original": "Khớp lớn nhất, hay đau khi lên xuống cầu thang", "value": "Khớp lớn nhất, hay đau khi lên xuống cầu thang"}, {"id": "text-126", "original": "Sụn khớp gối mòn dần theo tuổi, đặc biệt khi thừa cân. Gối hay kêu, đau khi leo cầu thang.", "value": "Sụn khớp gối mòn dần theo tuổi, đặc biệt khi thừa cân. Gối hay kêu, đau khi leo cầu thang."}, {"id": "text-127", "original": "Đau khi lên xuống cầu thang", "value": "Đau khi lên xuống cầu thang"}, {"id": "text-128", "original": "Cứng gối sau khi ngồi lâu", "value": "Cứng gối sau khi ngồi lâu"}, {"id": "text-129", "original": "Gối kêu, hơi sưng", "value": "Gối kêu, hơi sưng"}, {"id": "text-130", "original": "Đi bộ nhẹ thường xuyên", "value": "Đi bộ nhẹ thường xuyên"}, {"id": "text-131", "original": "Giữ cân nặng hợp lý để giảm áp lực lên gối", "value": "Giữ cân nặng hợp lý để giảm áp lực lên gối"}, {"id": "text-132", "original": "Dùng ghế ngồi cao vừa, tránh ngồi xổm", "value": "Dùng ghế ngồi cao vừa, tránh ngồi xổm"}, {"id": "text-133", "original": "Gối sưng nóng đỏ", "value": "Gối sưng nóng đỏ"}, {"id": "text-134", "original": "Không co hoặc duỗi được gối", "value": "Không co hoặc duỗi được gối"}, {"id": "text-135", "original": "Đau tăng dần dù đã nghỉ", "value": "Đau tăng dần dù đã nghỉ"}, {"id": "text-136", "original": "Cổ tay và bàn tay", "value": "Cổ tay và bàn tay"}, {"id": "text-137", "original": "Nơi hay tê cứng buổi sáng", "value": "Nơi hay tê cứng buổi sáng"}, {"id": "text-138", "original": "Cổ tay và các khớp ngón tay có thể tê, cứng, đau khi dây thần kinh bị chèn ép hoặc khớp bị viêm, thoái hóa.", "value": "Cổ tay và các khớp ngón tay có thể tê, cứng, đau khi dây thần kinh bị chèn ép hoặc khớp bị viêm, thoái hóa."}, {"id": "text-139", "original": "Tê bì ngón tay, nhất là ban đêm", "value": "Tê bì ngón tay, nhất là ban đêm"}, {"id": "text-140", "original": "Cứng ngón tay buổi sáng", "value": "Cứng ngón tay buổi sáng"}, {"id": "text-141", "original": "Cầm nắm yếu", "value": "Cầm nắm yếu"}, {"id": "text-142", "original": "Làm ấm tay, co duỗi ngón nhẹ nhàng", "value": "Làm ấm tay, co duỗi ngón nhẹ nhàng"}, {"id": "text-143", "original": "Ghi lại giờ tê, giờ cứng để báo bác sĩ", "value": "Ghi lại giờ tê, giờ cứng để báo bác sĩ"}, {"id": "text-144", "original": "Tránh cầm nắm mạnh liên tục", "value": "Tránh cầm nắm mạnh liên tục"}, {"id": "text-145", "original": "Cứng khớp buổi sáng kéo dài hơn 30 phút", "value": "Cứng khớp buổi sáng kéo dài hơn 30 phút"}, {"id": "text-146", "original": "Nhiều khớp sưng đau cùng lúc", "value": "Nhiều khớp sưng đau cùng lúc"}, {"id": "text-147", "original": "Huyết áp", "value": "Huyết áp"}, {"id": "text-148", "original": "Chạm vào chấm sáng để hiểu từng con số", "value": "Chạm vào chấm sáng để hiểu từng con số"}, {"id": "text-149", "original": "Số trên: tâm thu", "value": "Số trên: tâm thu"}, {"id": "text-150", "original": "Áp lực máu khi tim co bóp", "value": "Áp lực máu khi tim co bóp"}, {"id": "text-151", "original": "Đây là con số lớn, đọc trước. Nó cho biết lực đẩy máu của tim lên thành mạch. Mức bình thường ở người lớn là dưới 120.", "value": "Đây là con số lớn, đọc trước. Nó cho biết lực đẩy máu của tim lên thành mạch. Mức bình thường ở người lớn là dưới 120."}, {"id": "text-152", "original": "Huyết áp cao thường không có dấu hiệu rõ", "value": "Huyết áp cao thường không có dấu hiệu rõ"}, {"id": "text-153", "original": "Một số người đau đầu, chóng mặt, đau gáy", "value": "Một số người đau đầu, chóng mặt, đau gáy"}, {"id": "text-154", "original": "Vì vậy cần đo đều, không chỉ đo khi thấy khó chịu", "value": "Vì vậy cần đo đều, không chỉ đo khi thấy khó chịu"}, {"id": "text-155", "original": "Ngồi nghỉ 5 phút, lưng tựa, chân không bắt chéo", "value": "Ngồi nghỉ 5 phút, lưng tựa, chân không bắt chéo"}, {"id": "text-156", "original": "Đặt tay ngang tim, không nói chuyện khi đo", "value": "Đặt tay ngang tim, không nói chuyện khi đo"}, {"id": "text-157", "original": "Đo cùng giờ mỗi ngày và ghi lại", "value": "Đo cùng giờ mỗi ngày và ghi lại"}, {"id": "text-158", "original": "Số trên từ 180 trở lên: nghỉ 5 phút, đo lại; vẫn cao thì gọi bác sĩ hoặc 115", "value": "Số trên từ 180 trở lên: nghỉ 5 phút, đo lại; vẫn cao thì gọi bác sĩ hoặc 115"}, {"id": "text-159", "original": "Số dưới: tâm trương", "value": "Số dưới: tâm trương"}, {"id": "text-160", "original": "Áp lực máu khi tim nghỉ giữa hai nhịp", "value": "Áp lực máu khi tim nghỉ giữa hai nhịp"}, {"id": "text-161", "original": "Đây là con số nhỏ. Nó cho biết áp lực trong mạch khi tim giãn ra. Mức bình thường là dưới 80.", "value": "Đây là con số nhỏ. Nó cho biết áp lực trong mạch khi tim giãn ra. Mức bình thường là dưới 80."}, {"id": "text-162", "original": "Cũng thường không có dấu hiệu rõ", "value": "Cũng thường không có dấu hiệu rõ"}, {"id": "text-163", "original": "Có thể cao dù số trên chưa cao", "value": "Có thể cao dù số trên chưa cao"}, {"id": "text-164", "original": "Đọc cả hai số khi ghi", "value": "Đọc cả hai số khi ghi"}, {"id": "text-165", "original": "Báo bác sĩ nếu số dưới từ 90 trở lên nhiều ngày", "value": "Báo bác sĩ nếu số dưới từ 90 trở lên nhiều ngày"}, {"id": "text-166", "original": "Uống thuốc đúng giờ, đúng liều bác sĩ kê", "value": "Uống thuốc đúng giờ, đúng liều bác sĩ kê"}, {"id": "text-167", "original": "Số dưới từ 120 trở lên: nghỉ, đo lại; vẫn cao thì gọi bác sĩ hoặc 115", "value": "Số dưới từ 120 trở lên: nghỉ, đo lại; vẫn cao thì gọi bác sĩ hoặc 115"}, {"id": "text-168", "original": "Nhịp tim", "value": "Nhịp tim"}, {"id": "text-169", "original": "Số lần tim đập mỗi phút", "value": "Số lần tim đập mỗi phút"}, {"id": "text-170", "original": "Khi nghỉ, nhịp tim người lớn thường khoảng 60 đến 100 lần mỗi phút. Một số thuốc huyết áp làm nhịp chậm hơn bình thường.", "value": "Khi nghỉ, nhịp tim người lớn thường khoảng 60 đến 100 lần mỗi phút. Một số thuốc huyết áp làm nhịp chậm hơn bình thường."}, {"id": "text-171", "original": "Hồi hộp, đánh trống ngực", "value": "Hồi hộp, đánh trống ngực"}, {"id": "text-172", "original": "Mệt, choáng khi đứng dậy nhanh", "value": "Mệt, choáng khi đứng dậy nhanh"}, {"id": "text-173", "original": "Ghi nhịp cùng với huyết áp", "value": "Ghi nhịp cùng với huyết áp"}, {"id": "text-174", "original": "Đứng dậy từ từ, nhất là sau khi nằm lâu", "value": "Đứng dậy từ từ, nhất là sau khi nằm lâu"}, {"id": "text-175", "original": "Nhịp tim rất nhanh hoặc rất chậm kèm choáng, ngất", "value": "Nhịp tim rất nhanh hoặc rất chậm kèm choáng, ngất"}, {"id": "text-176", "original": "Đau ngực, khó thở", "value": "Đau ngực, khó thở"}, {"id": "text-177", "original": "Mức cần cảnh giác", "value": "Mức cần cảnh giác"}, {"id": "text-178", "original": "Khi nào gọi cấp cứu", "value": "Khi nào gọi cấp cứu"}, {"id": "text-179", "original": "Một lần đo cao chưa kết luận được bệnh. Nhưng nếu số đo rất cao hoặc có dấu hiệu bất thường thì không chờ đợi.", "value": "Một lần đo cao chưa kết luận được bệnh. Nhưng nếu số đo rất cao hoặc có dấu hiệu bất thường thì không chờ đợi."}, {"id": "text-180", "original": "Đau đầu dữ dội, đột ngột", "value": "Đau đầu dữ dội, đột ngột"}, {"id": "text-181", "original": "Méo miệng, yếu tay chân một bên, nói khó", "value": "Méo miệng, yếu tay chân một bên, nói khó"}, {"id": "text-182", "original": "Ngồi nghỉ, không tự uống thêm thuốc ngoài chỉ dẫn", "value": "Ngồi nghỉ, không tự uống thêm thuốc ngoài chỉ dẫn"}, {"id": "text-183", "original": "Gọi 115 hoặc nhờ người nhà đưa đến cơ sở y tế gần nhất", "value": "Gọi 115 hoặc nhờ người nhà đưa đến cơ sở y tế gần nhất"}, {"id": "text-184", "original": "Từ 180/120 trở lên kèm bất kỳ dấu hiệu nào ở trên: gọi 115 ngay", "value": "Từ 180/120 trở lên kèm bất kỳ dấu hiệu nào ở trên: gọi 115 ngay"}, {"id": "text-185", "original": "Cột sống, trụ cột của cơ thể", "value": "Cột sống, trụ cột của cơ thể"}, {"id": "text-186", "original": "Cột sống gồm những phần nào?", "value": "Cột sống gồm những phần nào?"}, {"id": "text-187", "original": "Cột sống chia thành các đoạn: cổ, ngực, thắt lưng, cùng và cụt. Giữa các đốt sống có đĩa đệm, giống miếng đệm giảm xóc.", "value": "Cột sống chia thành các đoạn: cổ, ngực, thắt lưng, cùng và cụt. Giữa các đốt sống có đĩa đệm, giống miếng đệm giảm xóc."}, {"id": "text-188", "original": "Vì sao cổ và thắt lưng hay đau?", "value": "Vì sao cổ và thắt lưng hay đau?"}, {"id": "text-189", "original": "Hai đoạn này chịu áp lực lớn nhất khi ngồi lâu, nâng vật nặng hoặc giữ tư thế sai. Khi đứng, thắt lưng chịu khoảng 100% sức nặng cơ thể; khi ngồi, áp lực tăng lên khoảng 150%.", "value": "Hai đoạn này chịu áp lực lớn nhất khi ngồi lâu, nâng vật nặng hoặc giữ tư thế sai. Khi đứng, thắt lưng chịu khoảng 100% sức nặng cơ thể; khi ngồi, áp lực tăng lên khoảng 150%."}, {"id": "text-190", "original": "Việc nhỏ bảo vệ cột sống", "value": "Việc nhỏ bảo vệ cột sống"}, {"id": "text-191", "original": "Đi bộ, bơi, yoga nhẹ để cột sống linh hoạt", "value": "Đi bộ, bơi, yoga nhẹ để cột sống linh hoạt"}, {"id": "text-192", "original": "Không xách nặng, không khom lưng đột ngột", "value": "Không xách nặng, không khom lưng đột ngột"}, {"id": "text-193", "original": "Cổ vai gáy: vì sao hay đau?", "value": "Cổ vai gáy: vì sao hay đau?"}, {"id": "text-194", "original": "Đau cổ vai gáy là gì?", "value": "Đau cổ vai gáy là gì?"}, {"id": "text-195", "original": "Là tình trạng các cơ vùng cổ, vai, gáy co cứng gây đau, có thể làm khó quay cổ. Cơn đau hay xuất hiện vào buổi sáng.", "value": "Là tình trạng các cơ vùng cổ, vai, gáy co cứng gây đau, có thể làm khó quay cổ. Cơn đau hay xuất hiện vào buổi sáng."}, {"id": "text-196", "original": "Nguyên nhân thường gặp", "value": "Nguyên nhân thường gặp"}, {"id": "text-197", "original": "Ngồi gù, cúi cổ nhìn điện thoại, ngồi một tư thế quá lâu", "value": "Ngồi gù, cúi cổ nhìn điện thoại, ngồi một tư thế quá lâu"}, {"id": "text-198", "original": "Thoái hóa hoặc thoát vị đĩa đệm cột sống cổ", "value": "Thoái hóa hoặc thoát vị đĩa đệm cột sống cổ"}, {"id": "text-199", "original": "Gặp lạnh đột ngột, căng thẳng, lo âu", "value": "Gặp lạnh đột ngột, căng thẳng, lo âu"}, {"id": "text-200", "original": "Chấn thương hoặc va chạm vùng cổ", "value": "Chấn thương hoặc va chạm vùng cổ"}, {"id": "text-201", "original": "Nên làm gì ở nhà?", "value": "Nên làm gì ở nhà?"}, {"id": "text-202", "original": "Chườm ấm vùng cổ, lót khăn mỏng để tránh bỏng", "value": "Chườm ấm vùng cổ, lót khăn mỏng để tránh bỏng"}, {"id": "text-203", "original": "Tập vận động cổ nhẹ, trong mức không đau", "value": "Tập vận động cổ nhẹ, trong mức không đau"}, {"id": "text-204", "original": "Nghỉ ngơi, ngủ gối vừa tầm", "value": "Nghỉ ngơi, ngủ gối vừa tầm"}, {"id": "text-205", "original": "Chú ý", "value": "Chú ý"}, {"id": "text-206", "original": "Đau cổ vai gáy kèm chóng mặt, buồn nôn hoặc đau ngực, khó thở cần được bác sĩ kiểm tra sớm.", "value": "Đau cổ vai gáy kèm chóng mặt, buồn nôn hoặc đau ngực, khó thở cần được bác sĩ kiểm tra sớm."}, {"id": "text-207", "original": "Thoái hóa và thoát vị đĩa đệm", "value": "Thoái hóa và thoát vị đĩa đệm"}, {"id": "text-208", "original": "Thoái hóa", "value": "Thoái hóa"}, {"id": "text-209", "original": "Là quá trình lão hóa tự nhiên của sụn, đĩa đệm, dây chằng và xương quanh cột sống. Đau thường tăng khi cử động.", "value": "Là quá trình lão hóa tự nhiên của sụn, đĩa đệm, dây chằng và xương quanh cột sống. Đau thường tăng khi cử động."}, {"id": "text-210", "original": "Thoát vị đĩa đệm", "value": "Thoát vị đĩa đệm"}, {"id": "text-211", "original": "Đĩa đệm bị rách hoặc lệch ra ngoài, có thể chèn vào dây thần kinh gây đau, tê, yếu. Ở cổ, thoát vị thường gặp ở các tầng C5-C6 và C6-C7.", "value": "Đĩa đệm bị rách hoặc lệch ra ngoài, có thể chèn vào dây thần kinh gây đau, tê, yếu. Ở cổ, thoát vị thường gặp ở các tầng C5-C6 và C6-C7."}, {"id": "text-212", "original": "Gai cột sống", "value": "Gai cột sống"}, {"id": "text-213", "original": "Là phần xương mọc thêm bất thường trên đốt sống, hay gặp ở cổ và thắt lưng, nơi chịu nhiều áp lực.", "value": "Là phần xương mọc thêm bất thường trên đốt sống, hay gặp ở cổ và thắt lưng, nơi chịu nhiều áp lực."}, {"id": "text-214", "original": "Điều cần nhớ", "value": "Điều cần nhớ"}, {"id": "text-215", "original": "Việc chẩn đoán và điều trị do bác sĩ quyết định", "value": "Việc chẩn đoán và điều trị do bác sĩ quyết định"}, {"id": "text-216", "original": "Không tự nắn, vặn, bẻ cổ hoặc lưng", "value": "Không tự nắn, vặn, bẻ cổ hoặc lưng"}, {"id": "text-217", "original": "Không tự dùng thuốc không rõ nguồn gốc", "value": "Không tự dùng thuốc không rõ nguồn gốc"}, {"id": "text-218", "original": "Giảm hoặc dừng tập nếu đau tăng lên", "value": "Giảm hoặc dừng tập nếu đau tăng lên"}, {"id": "text-219", "original": "Huyết áp: hai con số cần biết", "value": "Huyết áp: hai con số cần biết"}, {"id": "text-220", "original": "Đọc hai con số", "value": "Đọc hai con số"}, {"id": "text-221", "original": "Số trên là huyết áp tâm thu, khi tim co. Số dưới là tâm trương, khi tim nghỉ giữa hai nhịp. Ví dụ 120/80 mmHg.", "value": "Số trên là huyết áp tâm thu, khi tim co. Số dưới là tâm trương, khi tim nghỉ giữa hai nhịp. Ví dụ 120/80 mmHg."}, {"id": "text-222", "original": "Các mức tham khảo cho người lớn", "value": "Các mức tham khảo cho người lớn"}, {"id": "text-223", "original": "Bình thường: dưới 120 và dưới 80", "value": "Bình thường: dưới 120 và dưới 80"}, {"id": "text-224", "original": "Hơi cao: 120 đến 129 và dưới 80", "value": "Hơi cao: 120 đến 129 và dưới 80"}, {"id": "text-225", "original": "Cao độ 1: 130 đến 139 hoặc 80 đến 89", "value": "Cao độ 1: 130 đến 139 hoặc 80 đến 89"}, {"id": "text-226", "original": "Cao độ 2: từ 140 hoặc từ 90 trở lên", "value": "Cao độ 2: từ 140 hoặc từ 90 trở lên"}, {"id": "text-227", "original": "Rất cao, cần xử trí gấp: từ 180 hoặc từ 120 trở lên", "value": "Rất cao, cần xử trí gấp: từ 180 hoặc từ 120 trở lên"}, {"id": "text-228", "original": "Đo cho đúng", "value": "Đo cho đúng"}, {"id": "text-229", "original": "Ngồi nghỉ 5 phút, lưng tựa, hai chân đặt sát sàn", "value": "Ngồi nghỉ 5 phút, lưng tựa, hai chân đặt sát sàn"}, {"id": "text-230", "original": "Tay đặt ngang tim, không nói chuyện", "value": "Tay đặt ngang tim, không nói chuyện"}, {"id": "text-231", "original": "Không dùng cà phê, thuốc lá trước khi đo khoảng 30 phút", "value": "Không dùng cà phê, thuốc lá trước khi đo khoảng 30 phút"}, {"id": "text-232", "original": "Đo cùng giờ mỗi ngày, ghi lại cả hai số và nhịp tim", "value": "Đo cùng giờ mỗi ngày, ghi lại cả hai số và nhịp tim"}, {"id": "text-233", "original": "Mục tiêu huyết áp của mỗi người khác nhau. Hãy hỏi bác sĩ mức phù hợp với bạn.", "value": "Mục tiêu huyết áp của mỗi người khác nhau. Hãy hỏi bác sĩ mức phù hợp với bạn."}, {"id": "text-234", "original": "Huyết áp cao, đau gáy và chóng mặt", "value": "Huyết áp cao, đau gáy và chóng mặt"}, {"id": "text-235", "original": "Có liên quan gì không?", "value": "Có liên quan gì không?"}, {"id": "text-236", "original": "Cao huyết áp, xơ vữa động mạch hoặc thoái hóa cột sống cổ có thể làm máu lên não kém, gây chóng mặt và đau vùng cổ gáy. Gai cột sống cổ còn có thể làm huyết áp dao động.", "value": "Cao huyết áp, xơ vữa động mạch hoặc thoái hóa cột sống cổ có thể làm máu lên não kém, gây chóng mặt và đau vùng cổ gáy. Gai cột sống cổ còn có thể làm huyết áp dao động."}, {"id": "text-237", "original": "Vì sao phải đo đều?", "value": "Vì sao phải đo đều?"}, {"id": "text-238", "original": "Nhiều người huyết áp cao nhưng không thấy gì khác thường. Đau gáy hay đau đầu không đủ để biết huyết áp cao hay thấp, chỉ có đo mới biết.", "value": "Nhiều người huyết áp cao nhưng không thấy gì khác thường. Đau gáy hay đau đầu không đủ để biết huyết áp cao hay thấp, chỉ có đo mới biết."}, {"id": "text-239", "original": "Dấu hiệu cần gọi 115 ngay", "value": "Dấu hiệu cần gọi 115 ngay"}, {"id": "text-240", "original": "Đau gáy hoặc đau vai kèm đau thắt ngực, khó thở", "value": "Đau gáy hoặc đau vai kèm đau thắt ngực, khó thở"}, {"id": "text-241", "original": "Méo miệng, yếu hoặc tê một bên tay chân, nói khó", "value": "Méo miệng, yếu hoặc tê một bên tay chân, nói khó"}, {"id": "text-242", "original": "Đau đầu dữ dội đột ngột, chóng mặt nặng, ngất", "value": "Đau đầu dữ dội đột ngột, chóng mặt nặng, ngất"}, {"id": "text-243", "original": "Ngồi, đứng, nằm đúng cách", "value": "Ngồi, đứng, nằm đúng cách"}, {"id": "text-244", "original": "Khi ngồi", "value": "Khi ngồi"}, {"id": "text-245", "original": "Lưng sát ghế, hai chân đặt sát sàn", "value": "Lưng sát ghế, hai chân đặt sát sàn"}, {"id": "text-246", "original": "Màn hình điện thoại, tivi ngang tầm mắt", "value": "Màn hình điện thoại, tivi ngang tầm mắt"}, {"id": "text-247", "original": "Đứng dậy đi lại sau mỗi 45 đến 60 phút", "value": "Đứng dậy đi lại sau mỗi 45 đến 60 phút"}, {"id": "text-248", "original": "Khi nhấc đồ", "value": "Khi nhấc đồ"}, {"id": "text-249", "original": "Gập gối, giữ lưng thẳng, ôm đồ sát người", "value": "Gập gối, giữ lưng thẳng, ôm đồ sát người"}, {"id": "text-250", "original": "Không xách một bên quá nặng", "value": "Không xách một bên quá nặng"}, {"id": "text-251", "original": "Khi nằm", "value": "Khi nằm"}, {"id": "text-252", "original": "Chọn giường vừa cứng, tránh nệm quá mềm hoặc võng", "value": "Chọn giường vừa cứng, tránh nệm quá mềm hoặc võng"}, {"id": "text-253", "original": "Gối vừa tầm, không quá cao", "value": "Gối vừa tầm, không quá cao"}, {"id": "text-254", "original": "Khi dậy: nghiêng người, chống tay ngồi lên, rồi mới đứng", "value": "Khi dậy: nghiêng người, chống tay ngồi lên, rồi mới đứng"}, {"id": "text-255", "original": "Vận động đều", "value": "Vận động đều"}, {"id": "text-256", "original": "Đi bộ, bơi, yoga nhẹ giúp cột sống linh hoạt và hạn chế thoái hóa. Giữ cân nặng hợp lý để giảm áp lực lên cột sống và khớp gối.", "value": "Đi bộ, bơi, yoga nhẹ giúp cột sống linh hoạt và hạn chế thoái hóa. Giữ cân nặng hợp lý để giảm áp lực lên cột sống và khớp gối."}, {"id": "text-257", "original": "Khi nào cần đi khám ngay", "value": "Khi nào cần đi khám ngay"}, {"id": "text-258", "original": "Gọi 115 ngay", "value": "Gọi 115 ngay"}, {"id": "text-259", "original": "Méo miệng, tay chân yếu hoặc tê một bên, nói khó", "value": "Méo miệng, tay chân yếu hoặc tê một bên, nói khó"}, {"id": "text-260", "original": "Đau đầu dữ dội đột ngột", "value": "Đau đầu dữ dội đột ngột"}, {"id": "text-261", "original": "Huyết áp từ 180/120 trở lên kèm dấu hiệu trên", "value": "Huyết áp từ 180/120 trở lên kèm dấu hiệu trên"}, {"id": "text-262", "original": "Đi khám trong ngày hoặc sớm nhất", "value": "Đi khám trong ngày hoặc sớm nhất"}, {"id": "text-263", "original": "Tê hoặc yếu chân, tay kéo dài", "value": "Tê hoặc yếu chân, tay kéo dài"}, {"id": "text-264", "original": "Đau sau khi ngã hoặc chấn thương", "value": "Đau sau khi ngã hoặc chấn thương"}, {"id": "text-265", "original": "Đau lưng kèm sốt, sụt cân, đau tăng về đêm", "value": "Đau lưng kèm sốt, sụt cân, đau tăng về đêm"}, {"id": "text-266", "original": "Nên đi khám theo hẹn", "value": "Nên đi khám theo hẹn"}, {"id": "text-267", "original": "Đau cổ, lưng, khớp kéo dài trên vài tuần", "value": "Đau cổ, lưng, khớp kéo dài trên vài tuần"}, {"id": "text-268", "original": "Huyết áp đo nhiều ngày đều trên 130/80", "value": "Huyết áp đo nhiều ngày đều trên 130/80"}, {"id": "text-269", "original": "Muốn biết mục tiêu huyết áp và bài tập phù hợp", "value": "Muốn biết mục tiêu huyết áp và bài tập phù hợp"}, {"id": "text-270", "original": "Gập cổ, cúi nhẹ", "value": "Gập cổ, cúi nhẹ"}, {"id": "text-271", "original": "Giãn cơ sau gáy", "value": "Giãn cơ sau gáy"}, {"id": "text-272", "original": "Ngồi thẳng, vai thả lỏng, mắt nhìn thẳng", "value": "Ngồi thẳng, vai thả lỏng, mắt nhìn thẳng"}, {"id": "text-273", "original": "Từ từ cúi đầu về trước, cằm hướng về ngực, thở ra", "value": "Từ từ cúi đầu về trước, cằm hướng về ngực, thở ra"}, {"id": "text-274", "original": "Giữ 5 giây ở mức thoải mái rồi ngẩng đầu lên", "value": "Giữ 5 giây ở mức thoải mái rồi ngẩng đầu lên"}, {"id": "text-275", "original": "Chỉ cúi đến mức không đau.", "value": "Chỉ cúi đến mức không đau."}, {"id": "text-276", "original": "Nghiêng cổ sang bên", "value": "Nghiêng cổ sang bên"}, {"id": "text-277", "original": "Giãn cơ bên cổ, mỗi bên tính một lần", "value": "Giãn cơ bên cổ, mỗi bên tính một lần"}, {"id": "text-278", "original": "Ngồi thẳng, hai vai thả lỏng", "value": "Ngồi thẳng, hai vai thả lỏng"}, {"id": "text-279", "original": "Nghiêng đầu, tai hướng về vai, không nhún vai lên", "value": "Nghiêng đầu, tai hướng về vai, không nhún vai lên"}, {"id": "text-280", "original": "Giữ 5 giây, về giữa rồi đổi bên", "value": "Giữ 5 giây, về giữa rồi đổi bên"}, {"id": "text-281", "original": "Không dùng tay kéo đầu.", "value": "Không dùng tay kéo đầu."}, {"id": "text-282", "original": "Quay cổ", "value": "Quay cổ"}, {"id": "text-283", "original": "Giúp cổ quay dễ hơn", "value": "Giúp cổ quay dễ hơn"}, {"id": "text-284", "original": "Ngồi thẳng, nhìn thẳng phía trước", "value": "Ngồi thẳng, nhìn thẳng phía trước"}, {"id": "text-285", "original": "Từ từ quay đầu sang phải đến mức thoải mái", "value": "Từ từ quay đầu sang phải đến mức thoải mái"}, {"id": "text-286", "original": "Giữ 3 giây, về giữa rồi quay sang trái", "value": "Giữ 3 giây, về giữa rồi quay sang trái"}, {"id": "text-287", "original": "Quay chậm, không giật mạnh.", "value": "Quay chậm, không giật mạnh."}, {"id": "text-288", "original": "Làm ấm và thả lỏng vai", "value": "Làm ấm và thả lỏng vai"}, {"id": "text-289", "original": "Ngồi hoặc đứng thẳng, hai tay buông thõng", "value": "Ngồi hoặc đứng thẳng, hai tay buông thõng"}, {"id": "text-290", "original": "Nhấc hai vai lên cao, kéo ra sau rồi hạ xuống thành một vòng tròn lớn", "value": "Nhấc hai vai lên cao, kéo ra sau rồi hạ xuống thành một vòng tròn lớn"}, {"id": "text-291", "original": "Làm chậm 5 vòng, rồi đổi chiều", "value": "Làm chậm 5 vòng, rồi đổi chiều"}, {"id": "text-292", "original": "Thở đều, không nín thở.", "value": "Thở đều, không nín thở."}, {"id": "text-293", "original": "Ép bả vai", "value": "Ép bả vai"}, {"id": "text-294", "original": "Mở ngực, giảm gù lưng", "value": "Mở ngực, giảm gù lưng"}, {"id": "text-295", "original": "Ngồi thẳng, hai tay để xuôi", "value": "Ngồi thẳng, hai tay để xuôi"}, {"id": "text-296", "original": "Kéo hai bả vai về phía sau, như kẹp một cây bút giữa hai bả vai", "value": "Kéo hai bả vai về phía sau, như kẹp một cây bút giữa hai bả vai"}, {"id": "text-297", "original": "Giữ 5 giây rồi thả lỏng", "value": "Giữ 5 giây rồi thả lỏng"}, {"id": "text-298", "original": "Không ưỡn lưng quá mức.", "value": "Không ưỡn lưng quá mức."}, {"id": "text-299", "original": "Xoay người nhẹ khi ngồi ghế", "value": "Xoay người nhẹ khi ngồi ghế"}, {"id": "text-300", "original": "Giúp lưng linh hoạt", "value": "Giúp lưng linh hoạt"}, {"id": "text-301", "original": "Ngồi thẳng trên ghế vững, hai chân đặt sát sàn", "value": "Ngồi thẳng trên ghế vững, hai chân đặt sát sàn"}, {"id": "text-302", "original": "Từ từ xoay thân sang phải, tay phải chạm lưng ghế", "value": "Từ từ xoay thân sang phải, tay phải chạm lưng ghế"}, {"id": "text-303", "original": "Giữ 3 giây, về giữa rồi xoay sang trái", "value": "Giữ 3 giây, về giữa rồi xoay sang trái"}, {"id": "text-304", "original": "Xoay bằng cả thân người, không vặn cổ.", "value": "Xoay bằng cả thân người, không vặn cổ."}, {"id": "text-305", "original": "Không làm động tác mạnh, đột ngột như nắn, vặn, bẻ cổ và lưng. Nếu đau tăng, tê hoặc chóng mặt thì dừng lại và hỏi bác sĩ.", "value": "Không làm động tác mạnh, đột ngột như nắn, vặn, bẻ cổ và lưng. Nếu đau tăng, tê hoặc chóng mặt thì dừng lại và hỏi bác sĩ."}, {"id": "text-306", "original": "Rất cao", "value": "Rất cao"}, {"id": "text-307", "original": "Nghỉ 5 phút rồi đo lại. Nếu vẫn từ 180/120 trở lên, hoặc có đau ngực, khó thở, méo miệng, yếu liệt, nói khó, hãy gọi 115.", "value": "Nghỉ 5 phút rồi đo lại. Nếu vẫn từ 180/120 trở lên, hoặc có đau ngực, khó thở, méo miệng, yếu liệt, nói khó, hãy gọi 115."}, {"id": "text-308", "original": "Cao độ 2", "value": "Cao độ 2"}, {"id": "text-309", "original": "Nên báo bác sĩ trong thời gian sớm. Tiếp tục uống thuốc đúng chỉ định, không tự tăng giảm liều.", "value": "Nên báo bác sĩ trong thời gian sớm. Tiếp tục uống thuốc đúng chỉ định, không tự tăng giảm liều."}, {"id": "text-310", "original": "Cao độ 1", "value": "Cao độ 1"}, {"id": "text-311", "original": "Đo lại vài ngày liên tiếp, ghi lại và trao đổi với bác sĩ ở lần khám tới.", "value": "Đo lại vài ngày liên tiếp, ghi lại và trao đổi với bác sĩ ở lần khám tới."}, {"id": "text-312", "original": "Hơi cao", "value": "Hơi cao"}, {"id": "text-313", "original": "Giữ nếp sống lành mạnh, vận động nhẹ và đo đều.", "value": "Giữ nếp sống lành mạnh, vận động nhẹ và đo đều."}, {"id": "text-314", "original": "Hơi thấp", "value": "Hơi thấp"}, {"id": "text-315", "original": "Nếu thấy choáng, hoa mắt, hãy ngồi nghỉ, đứng dậy từ từ. Báo bác sĩ nếu hay bị.", "value": "Nếu thấy choáng, hoa mắt, hãy ngồi nghỉ, đứng dậy từ từ. Báo bác sĩ nếu hay bị."}, {"id": "text-316", "original": "Bình thường", "value": "Bình thường"}, {"id": "text-317", "original": "Rất tốt. Tiếp tục giữ nếp sống lành mạnh và đo đều.", "value": "Rất tốt. Tiếp tục giữ nếp sống lành mạnh và đo đều."}, {"id": "text-318", "original": "Không đau", "value": "Không đau"}, {"id": "text-319", "original": "Nhẹ", "value": "Nhẹ"}, {"id": "text-320", "original": "Hơi đau", "value": "Hơi đau"}, {"id": "text-321", "original": "Khá đau", "value": "Khá đau"}, {"id": "text-322", "original": "Rất đau", "value": "Rất đau"}, {"id": "text-323", "original": "Dữ dội", "value": "Dữ dội"}, {"id": "text-324", "original": "Lưng", "value": "Lưng"}, {"id": "text-325", "original": "Khớp", "value": "Khớp"}, {"id": "text-326", "original": "Khác", "value": "Khác"}, {"id": "text-327", "original": "Chủ nhật", "value": "Chủ nhật"}, {"id": "text-328", "original": "Thứ hai", "value": "Thứ hai"}, {"id": "text-329", "original": "Thứ ba", "value": "Thứ ba"}, {"id": "text-330", "original": "Thứ tư", "value": "Thứ tư"}, {"id": "text-331", "original": "Thứ năm", "value": "Thứ năm"}, {"id": "text-332", "original": "Thứ sáu", "value": "Thứ sáu"}, {"id": "text-333", "original": "Thứ bảy", "value": "Thứ bảy"}, {"id": "text-334", "original": "Ngồi lâu thì cứ 45 đến 60 phút đứng dậy đi lại một chút.", "value": "Ngồi lâu thì cứ 45 đến 60 phút đứng dậy đi lại một chút."}, {"id": "text-335", "original": "Màn hình điện thoại nên ngang tầm mắt, đừng cúi cổ nhìn xuống.", "value": "Màn hình điện thoại nên ngang tầm mắt, đừng cúi cổ nhìn xuống."}, {"id": "text-336", "original": "Đo huyết áp lúc ngồi nghỉ 5 phút, tay đặt ngang tim.", "value": "Đo huyết áp lúc ngồi nghỉ 5 phút, tay đặt ngang tim."}, {"id": "text-337", "original": "Nằm giường vừa cứng, tránh nệm quá mềm hoặc võng.", "value": "Nằm giường vừa cứng, tránh nệm quá mềm hoặc võng."}, {"id": "text-338", "original": "Đứng dậy từ từ khi vừa nằm hoặc ngồi lâu, để khỏi choáng.", "value": "Đứng dậy từ từ khi vừa nằm hoặc ngồi lâu, để khỏi choáng."}, {"id": "text-339", "original": "Khi nhấc đồ: gập gối, giữ lưng thẳng, ôm đồ sát người.", "value": "Khi nhấc đồ: gập gối, giữ lưng thẳng, ôm đồ sát người."}, {"id": "text-340", "original": "Sáng", "value": "Sáng"}, {"id": "text-341", "original": "trước 11 giờ", "value": "trước 11 giờ"}, {"id": "text-342", "original": "Trưa", "value": "Trưa"}, {"id": "text-343", "original": "11 đến 14 giờ", "value": "11 đến 14 giờ"}, {"id": "text-344", "original": "Tối", "value": "Tối"}, {"id": "text-345", "original": "từ 14 giờ trở đi", "value": "từ 14 giờ trở đi"}, {"id": "text-346", "original": "Uống thuốc", "value": "Uống thuốc"}, {"id": "text-347", "original": "Uống thuốc buổi sáng", "value": "Uống thuốc buổi sáng"}, {"id": "text-348", "original": "Tên thuốc", "value": "Tên thuốc"}, {"id": "text-349", "original": "Số lượng", "value": "Số lượng"}, {"id": "text-350", "original": "Công dụng, lưu ý khi uống", "value": "Công dụng, lưu ý khi uống"}, {"id": "text-351", "original": "Thêm một loại thuốc", "value": "Thêm một loại thuốc"}, {"id": "text-352", "original": "Đo huyết áp", "value": "Đo huyết áp"}, {"id": "text-353", "original": "Tập nhẹ", "value": "Tập nhẹ"}, {"id
ype": "list", "content": "Chườm ấm vùng cổ, lót khăn mỏng để tránh bỏng\nTập vận động cổ nhẹ, trong mức không đau\nNghỉ ngơi, ngủ gối vừa tầm", "sort_order": 3}, {"id": "l2-4", "article_id": "l2", "heading": "Chú ý", "type": "paragraph", "content": "Đau cổ vai gáy kèm chóng mặt, buồn nôn hoặc đau ngực, khó thở cần được bác sĩ kiểm tra sớm.", "sort_order": 4}, {"id": "l3-1", "article_id": "l3", "heading": "Thoái hóa", "type": "paragraph", "content": "Là quá trình lão hóa tự nhiên của sụn, đĩa đệm, dây chằng và xương quanh cột sống. Đau thường tăng khi cử động.", "sort_order": 1}, {"id": "l3-2", "article_id": "l3", "heading": "Thoát vị đĩa đệm", "type": "paragraph", "content": "Đĩa đệm bị rách hoặc lệch ra ngoài, có thể chèn vào dây thần kinh gây đau, tê, yếu. Ở cổ, thoát vị thường gặp ở các tầng C5-C6 và C6-C7.", "sort_order": 2}, {"id": "l3-3", "article_id": "l3", "heading": "Gai cột sống", "type": "paragraph", "content": "Là phần xương mọc thêm bất thường trên đốt sống, hay gặp ở cổ và thắt lưng, nơi chịu nhiều áp lực.", "sort_order": 3}, {"id": "l3-4", "article_id": "l3", "heading": "Điều cần nhớ", "type": "list", "content": "Việc chẩn đoán và điều trị do bác sĩ quyết định\nKhông tự nắn, vặn, bẻ cổ hoặc lưng\nKhông tự dùng thuốc không rõ nguồn gốc\nGiảm hoặc dừng tập nếu đau tăng lên", "sort_order": 4}, {"id": "l4-1", "article_id": "l4", "heading": "Đọc hai con số", "type": "paragraph", "content": "Số trên là huyết áp tâm thu, khi tim co. Số dưới là tâm trương, khi tim nghỉ giữa hai nhịp. Ví dụ 120/80 mmHg.", "sort_order": 1}, {"id": "l4-2", "article_id": "l4", "heading": "Các mức tham khảo cho người lớn", "type": "list", "content": "Bình thường: dưới 120 và dưới 80\nHơi cao: 120 đến 129 và dưới 80\nCao độ 1: 130 đến 139 hoặc 80 đến 89\nCao độ 2: từ 140 hoặc từ 90 trở lên\nRất cao, cần xử trí gấp: từ 180 hoặc từ 120 trở lên", "sort_order": 2}, {"id": "l4-3", "article_id": "l4", "heading": "Đo cho đúng", "type": "list", "content": "Ngồi nghỉ 5 phút, lưng tựa, hai chân đặt sát sàn\nTay đặt ngang tim, không nói chuyện\nKhông dùng cà phê, thuốc lá trước khi đo khoảng 30 phút\nĐo cùng giờ mỗi ngày, ghi lại cả hai số và nhịp tim", "sort_order": 3}, {"id": "l4-4", "article_id": "l4", "heading": "Chú ý", "type": "paragraph", "content": "Mục tiêu huyết áp của mỗi người khác nhau. Hãy hỏi bác sĩ mức phù hợp với bạn.", "sort_order": 4}, {"id": "l5-1", "article_id": "l5", "heading": "Có liên quan gì không?", "type": "paragraph", "content": "Cao huyết áp, xơ vữa động mạch hoặc thoái hóa cột sống cổ có thể làm máu lên não kém, gây chóng mặt và đau vùng cổ gáy. Gai cột sống cổ còn có thể làm huyết áp dao động.", "sort_order": 1}, {"id": "l5-2", "article_id": "l5", "heading": "Vì sao phải đo đều?", "type": "paragraph", "content": "Nhiều người huyết áp cao nhưng không thấy gì khác thường. Đau gáy hay đau đầu không đủ để biết huyết áp cao hay thấp, chỉ có đo mới biết.", "sort_order": 2}, {"id": "l5-3", "article_id": "l5", "heading": "Dấu hiệu cần gọi 115 ngay", "type": "list", "content": "Đau gáy hoặc đau vai kèm đau thắt ngực, khó thở\nMéo miệng, yếu hoặc tê một bên tay chân, nói khó\nĐau đầu dữ dội đột ngột, chóng mặt nặng, ngất", "sort_order": 3}, {"id": "l6-1", "article_id": "l6", "heading": "Khi ngồi", "type": "list", "content": "Lưng sát ghế, hai chân đặt sát sàn\nMàn hình điện thoại, tivi ngang tầm mắt\nĐứng dậy đi lại sau mỗi 45 đến 60 phút", "sort_order": 1}, {"id": "l6-2", "article_id": "l6", "heading": "Khi nhấc đồ", "type": "list", "content": "Gập gối, giữ lưng thẳng, ôm đồ sát người\nKhông xách một bên quá nặng", "sort_order": 2}, {"id": "l6-3", "article_id": "l6", "heading": "Khi nằm", "type": "list", "content": "Chọn giường vừa cứng, tránh nệm quá mềm hoặc võng\nGối vừa tầm, không quá cao\nKhi dậy: nghiêng người, chống tay ngồi lên, rồi mới đứng", "sort_order": 3}, {"id": "l6-4", "article_id": "l6", "heading": "Vận động đều", "type": "paragraph", "content": "Đi bộ, bơi, yoga nhẹ giúp cột sống linh hoạt và hạn chế thoái hóa. Giữ cân nặng hợp lý để giảm áp lực lên cột sống và khớp gối.", "sort_order": 4}, {"id": "l7-1", "article_id": "l7", "heading": "Gọi 115 ngay", "type": "list", "content": "Đau ngực, khó thở\nMéo miệng, tay chân yếu hoặc tê một bên, nói khó\nĐau đầu dữ dội đột ngột\nHuyết áp từ 180/120 trở lên kèm dấu hiệu trên", "sort_order": 1}, {"id": "l7-2", "article_id": "l7", "heading": "Đi khám trong ngày hoặc sớm nhất", "type": "list", "content": "Tê hoặc yếu chân, tay kéo dài\nTiểu tiện hoặc đại tiện không tự chủ\nĐau sau khi ngã hoặc chấn thương\nĐau lưng kèm sốt, sụt cân, đau tăng về đêm", "sort_order": 2}, {"id": "l7-3", "article_id": "l7", "heading": "Nên đi khám theo hẹn", "type": "list", "content": "Đau cổ, lưng, khớp kéo dài trên vài tuần\nHuyết áp đo nhiều ngày đều trên 130/80\nMuốn biết mục tiêu huyết áp và bài tập phù hợp", "sort_order": 3}], "Products": [{"id": "goi-mau", "name": "Gối hỗ trợ — sản phẩm minh họa", "price": 250000, "currency": "VND", "image_url": "", "video_url": "", "buy_url": "", "description": "Dữ liệu minh họa. Quản trị viên thay bằng sản phẩm thực tế.", "published": false, "sort_order": 1, "button_label": "", "button_class": "", "video_button_label": "", "video_button_class": ""}], "Topics": [{"id": "neck", "name": "Cổ vai gáy", "icon": "neck", "data_json": "{\"id\": \"neck\", \"name\": \"Cổ vai gáy\", \"icon\": \"neck\", \"hint\": \"Chạm vào chấm sáng để xem từng vùng\", \"spots\": [{\"x\": 50, \"y\": 35.5, \"name\": \"Gáy và đốt sống cổ\", \"sub\": \"Phần sau cổ, nơi đầu tựa lên cột sống\", \"what\": \"Các cơ sau gáy giữ đầu thẳng. Khi cúi nhìn điện thoại, ngồi gù hoặc gặp lạnh đột ngột, các cơ này co cứng và gây đau.\", \"feel\": [\"Cứng cổ, khó quay đầu, nhất là buổi sáng\", \"Mỏi gáy, nặng đầu\", \"Đôi khi chóng mặt hoặc đau đầu kèm theo\"], \"do\": [\"Chườm ấm vùng gáy, lót khăn mỏng để tránh bỏng\", \"Tập gập, nghiêng, quay cổ thật chậm trong mức không đau\", \"Chỉnh gối cao vừa phải, không quá cao\"], \"see\": [\"Đau gáy kèm chóng mặt, buồn nôn kéo dài\", \"Đau gáy kèm đau ngực hoặc khó thở: gọi 115 ngay\", \"Đau sau khi bị ngã hoặc va chạm mạnh\"], \"urgent\": true}, {\"x\": 29, \"y\": 49.5, \"name\": \"Cơ vai\", \"sub\": \"Cơ thang, từ gáy xuống hai bên vai\", \"what\": \"Hai bên vai gánh sức nặng của tay và đầu. Căng thẳng, ngồi lâu hay mang xách nặng làm cơ vai căng cứng.\", \"feel\": [\"Vai nặng, mỏi như đeo vật nặng\", \"Đau khi giơ tay lên cao\", \"Căng cứng nhiều hơn khi lo lắng\"], \"do\": [\"Xoay vai chậm theo vòng tròn\", \"Thở chậm, hạ hai vai xuống thả lỏng\", \"Đổi bên khi xách đồ, không xách quá nặng\"], \"see\": [\"Đau vai tăng dần dù đã nghỉ\", \"Không giơ nổi tay lên\", \"Đau vai trái lan ngực, ra hàm: gọi 115\"], \"urgent\": true}, {\"x\": 65, \"y\": 69.5, \"name\": \"Bả vai và lưng trên\", \"sub\": \"Hai xương bả vai, hai bên cột sống ngực\", \"what\": \"Ngồi gù lưng khiến hai bả vai bị kéo ra trước, các cơ giữa lưng bị kéo giãn và mỏi.\", \"feel\": [\"Mỏi giữa hai bả vai\", \"Lưng trên nặng, khó ngồi thẳng lâu\"], \"do\": [\"Bài ép bả vai: kéo hai bả vai về phía sau rồi thả\", \"Ngồi sát lưng ghế, tựa thẳng\", \"Đứng dậy đi lại mỗi 45 đến 60 phút\"], \"see\": [\"Đau kèm tức ngực, khó thở\", \"Đau về đêm, tăng dần, kèm sốt hoặc sụt cân\"], \"urgent\": true}, {\"x\": 13.5, \"y\": 83, \"name\": \"Cánh tay và bàn tay\", \"sub\": \"Nơi cơn tê có thể lan xuống\", \"what\": \"Khi đĩa đệm hoặc gai xương ở cổ chèn vào dây thần kinh, cảm giác tê hoặc đau có thể lan từ cổ xuống vai, cánh tay và các ngón tay.\", \"feel\": [\"Tê bì, kiến bò ở cánh tay hoặc ngón tay\", \"Tay yếu, cầm đồ dễ rơi\", \"Đau lan từ cổ xuống tay\"], \"do\": [\"Ghi lại vị trí tê và thời điểm xuất hiện\", \"Tránh ngủ tư thế đè lên tay\", \"Báo bác sĩ để được kiểm tra thần kinh\"], \"see\": [\"Tê yếu tay kéo dài vài ngày\", \"Tay yếu đột ngột một bên, kèm méo miệng hoặc nói khó: gọi 115\"], \"urgent\": true}]}", "sort_order": 1}, {"id": "spine", "name": "Cột sống", "icon": "spine", "data_json": "{\"id\": \"spine\", \"name\": \"Cột sống\", \"icon\": \"spine\", \"hint\": \"Chạm vào chấm sáng để xem từng đoạn cột sống\", \"spots\": [{\"x\": 80, \"y\": 27, \"name\": \"Đoạn cổ\", \"sub\": \"7 đốt sống, ký hiệu C1 đến C7\", \"what\": \"Đỡ đầu và cho phép cúi, ngửa, xoay. Đoạn cổ linh hoạt nhưng đĩa đệm dễ mòn khi cúi đầu nhiều.\", \"feel\": [\"Đau mỏi gáy, cứng cổ\", \"Tê lan xuống vai và tay\", \"Đau đầu phía sau\"], \"do\": [\"Giữ màn hình ngang tầm mắt\", \"Đổi tư thế sau mỗi 45 đến 60 phút\", \"Tập nhẹ vận động cổ theo hướng dẫn\"], \"see\": [\"Tê yếu tay kéo dài\", \"Chóng mặt kèm đau cổ\"], \"urgent\": false, \"band\": 0}, {\"x\": 80, \"y\": 50.5, \"name\": \"Đoạn ngực\", \"sub\": \"12 đốt sống, ký hiệu T1 đến T12\", \"what\": \"Gắn với xương sườn nên ít cử động hơn, nhưng hay mỏi khi ngồi gù lưng lâu.\", \"feel\": [\"Mỏi lưng giữa\", \"Đau khi hít sâu hoặc xoay người\", \"Vai khom về phía trước\"], \"do\": [\"Ngồi sát lưng ghế, vai thả lỏng\", \"Mở ngực, ép bả vai vài lần mỗi ngày\", \"Đi bộ nhẹ mỗi ngày\"], \"see\": [\"Đau lưng kèm đau ngực hoặc khó thở: gọi 115\", \"Đau lưng tăng dần về đêm, sốt, sụt cân\"], \"urgent\": true, \"band\": 1}, {\"x\": 80, \"y\": 74, \"name\": \"Đoạn thắt lưng\", \"sub\": \"5 đốt sống lớn, ký hiệu L1 đến L5\", \"what\": \"Chịu phần lớn sức nặng cơ thể. Khi đứng, thắt lưng chịu khoảng 100% trọng lượng; khi ngồi, áp lực tăng lên khoảng 150%.\", \"feel\": [\"Đau lưng dưới, cứng lưng buổi sáng\", \"Đau lan xuống mông và chân\", \"Đau khi cúi hoặc nhấc đồ\"], \"do\": [\"Không xách vật nặng, không khom lưng đột ngột\", \"Nằm giường vừa cứng, tránh nệm quá mềm hoặc võng\", \"Đi bộ nhẹ, không ngồi hoặc đứng quá lâu\"], \"see\": [\"Tê yếu một hoặc hai chân\", \"Tiểu tiện hoặc đại tiện không tự chủ\", \"Đau sau khi ngã\"], \"urgent\": true, \"band\": 2}, {\"x\": 80, \"y\": 90.5, \"name\": \"Xương cùng và xương cụt\", \"sub\": \"Phần cuối cột sống, nối với khung chậu\", \"what\": \"Xương cùng nối cột sống với khung chậu. Xương cụt là đoạn nhỏ ở cuối cùng.\", \"feel\": [\"Đau vùng mông hoặc xương cụt khi ngồi lâu\"], \"do\": [\"Ngồi đệm mỏng, mềm vừa\", \"Đứng dậy và đi lại sau mỗi 45 đến 60 phút\", \"Đổi tư thế, không ngồi lệch một bên\"], \"see\": [\"Đau dữ dội sau ngã\", \"Đau không giảm dù đã đổi tư thế\"], \"urgent\": false, \"band\": 3}]}", "sort_order": 2}, {"id": "joint", "name": "Xương khớp", "icon": "bone", "data_json": "{\"id\": \"joint\", \"name\": \"Xương khớp\", \"icon\": \"bone\", \"hint\": \"Chạm vào chấm sáng để xem từng khớp\", \"spots\": [{\"x\": 39.3, \"y\": 25, \"name\": \"Khớp vai\", \"sub\": \"Nơi cánh tay nối với thân\", \"what\": \"Khớp vai cử động rất rộng nên dễ bị mỏi, đau khi làm việc tay cao hoặc gánh nặng.\", \"feel\": [\"Đau khi giơ tay hoặc với ra sau\", \"Cứng vai buổi sáng\", \"Khó cài áo, chải đầu\"], \"do\": [\"Xoay vai nhẹ nhàng mỗi ngày\", \"Không gánh, xách nặng\", \"Chườm ấm trước khi tập\"], \"see\": [\"Không nâng nổi tay\", \"Đau về đêm làm mất ngủ\", \"Đau sau khi ngã\"], \"urgent\": false}, {\"x\": 43.3, \"y\": 55, \"name\": \"Khớp háng\", \"sub\": \"Nơi đùi nối với khung chậu\", \"what\": \"Khớp háng đỡ cả sức nặng khi đứng và đi. Sụn mòn theo tuổi gây đau khi đứng lên, bước đi.\", \"feel\": [\"Đau vùng bẹn hoặc mông\", \"Đứng lên khỏi ghế khó, cứng khớp\", \"Bước đi đau, đi cà nhắc\"], \"do\": [\"Dùng ghế cao vừa tầm, có tay vịn\", \"Đi bộ chậm trên nền phẳng\", \"Giữ cân nặng hợp lý\"], \"see\": [\"Đau tăng nhanh, đi lại khó\", \"Đau dữ dội sau ngã: không tự dậy, gọi người giúp hoặc 115\"], \"urgent\": true}, {\"x\": 42.7, \"y\": 76.5, \"name\": \"Khớp gối\", \"sub\": \"Khớp lớn nhất, hay đau khi lên xuống cầu thang\", \"what\": \"Sụn khớp gối mòn dần theo tuổi, đặc biệt khi thừa cân. Gối hay kêu, đau khi leo cầu thang.\", \"feel\": [\"Đau khi lên xuống cầu thang\", \"Cứng gối sau khi ngồi lâu\", \"Gối kêu, hơi sưng\"], \"do\": [\"Đi bộ nhẹ thường xuyên\", \"Giữ cân nặng hợp lý để giảm áp lực lên gối\", \"Dùng ghế ngồi cao vừa, tránh ngồi xổm\"], \"see\": [\"Gối sưng nóng đỏ\", \"Không co hoặc duỗi được gối\", \"Đau tăng dần dù đã nghỉ\"], \"urgent\": false}, {\"x\": 24, \"y\": 59.5, \"name\": \"Cổ tay và bàn tay\", \"sub\": \"Nơi hay tê cứng buổi sáng\", \"what\": \"Cổ tay và các khớp ngón tay có thể tê, cứng, đau khi dây thần kinh bị chèn ép hoặc khớp bị viêm, thoái hóa.\", \"feel\": [\"Tê bì ngón tay, nhất là ban đêm\", \"Cứng ngón tay buổi sáng\", \"Cầm nắm yếu\"], \"do\": [\"Làm ấm tay, co duỗi ngón nhẹ nhàng\", \"Ghi lại giờ tê, giờ cứng để báo bác sĩ\", \"Tránh cầm nắm mạnh liên tục\"], \"see\": [\"Cứng khớp buổi sáng kéo dài hơn 30 phút\", \"Nhiều khớp sưng đau cùng lúc\"], \"urgent\": false}]}", "sort_order": 3}, {"id": "bp", "name": "Huyết áp", "icon": "heart", "data_json": "{\"id\": \"bp\", \"name\": \"Huyết áp\", \"icon\": \"heart\", \"hint\": \"Chạm vào chấm sáng để hiểu từng con số\", \"spots\": [{\"x\": 75, \"y\": 29, \"name\": \"Số trên: tâm thu\", \"sub\": \"Áp lực máu khi tim co bóp\", \"what\": \"Đây là con số lớn, đọc trước. Nó cho biết lực đẩy máu của tim lên thành mạch. Mức bình thường ở người lớn là dưới 120.\", \"feel\": [\"Huyết áp cao thường không có dấu hiệu rõ\", \"Một số người đau đầu, chóng mặt, đau gáy\", \"Vì vậy cần đo đều, không chỉ đo khi thấy khó chịu\"], \"do\": [\"Ngồi nghỉ 5 phút, lưng tựa, chân không bắt chéo\", \"Đặt tay ngang tim, không nói chuyện khi đo\", \"Đo cùng giờ mỗi ngày và ghi lại\"], \"see\": [\"Số trên từ 180 trở lên: nghỉ 5 phút, đo lại; vẫn cao thì gọi bác sĩ hoặc 115\"], \"urgent\": true}, {\"x\": 75, \"y\": 47, \"name\": \"Số dưới: tâm trương\", \"sub\": \"Áp lực máu khi tim nghỉ giữa hai nhịp\", \"what\": \"Đây là con số nhỏ. Nó cho biết áp lực trong mạch khi tim giãn ra. Mức bình thường là dưới 80.\", \"feel\": [\"Cũng thường không có dấu hiệu rõ\", \"Có thể cao dù số trên chưa cao\"], \"do\": [\"Đọc cả hai số khi ghi\", \"Báo bác sĩ nếu số dưới từ 90 trở lên nhiều ngày\", \"Uống thuốc đúng giờ, đúng liều bác sĩ kê\"], \"see\": [\"Số dưới từ 120 trở lên: nghỉ, đo lại; vẫn cao thì gọi bác sĩ hoặc 115\"], \"urgent\": true}, {\"x\": 75, \"y\": 66.5, \"name\": \"Nhịp tim\", \"sub\": \"Số lần tim đập mỗi phút\", \"what\": \"Khi nghỉ, nhịp tim người lớn thường khoảng 60 đến 100 lần mỗi phút. Một số thuốc huyết áp làm nhịp chậm hơn bình thường.\", \"feel\": [\"Hồi hộp, đánh trống ngực\", \"Mệt, choáng khi đứng dậy nhanh\"], \"do\": [\"Ghi nhịp cùng với huyết áp\", \"Đứng dậy từ từ, nhất là sau khi nằm lâu\"], \"see\": [\"Nhịp tim rất nhanh hoặc rất chậm kèm choáng, ngất\", \"Đau ngực, khó thở\"], \"urgent\": true}, {\"x\": 50, \"y\": 82.5, \"name\": \"Mức cần cảnh giác\", \"sub\": \"Khi nào gọi cấp cứu\", \"what\": \"Một lần đo cao chưa kết luận được bệnh. Nhưng nếu số đo rất cao hoặc có dấu hiệu bất thường thì không chờ đợi.\", \"feel\": [\"Đau đầu dữ dội, đột ngột\", \"Đau ngực, khó thở\", \"Méo miệng, yếu tay chân một bên, nói khó\"], \"do\": [\"Ngồi nghỉ, không tự uống thêm thuốc ngoài chỉ dẫn\", \"Gọi 115 hoặc nhờ người nhà đưa đến cơ sở y tế gần nhất\"], \"see\": [\"Từ 180/120 trở lên kèm bất kỳ dấu hiệu nào ở trên: gọi 115 ngay\"], \"urgent\": true}]}", "sort_order": 4}], "Exercises": [{"id": "e1", "name": "Gập cổ, cúi nhẹ", "fig": "flex", "reps": 5, "hold": 5, "sub": "Giãn cơ sau gáy", "steps": "Ngồi thẳng, vai thả lỏng, mắt nhìn thẳng\nTừ từ cúi đầu về trước, cằm hướng về ngực, thở ra\nGiữ 5 giây ở mức thoải mái rồi ngẩng đầu lên", "tip": "Chỉ cúi đến mức không đau.", "published": true, "sort_order": 1}, {"id": "e2", "name": "Nghiêng cổ sang bên", "fig": "tilt", "reps": 5, "hold": 5, "sub": "Giãn cơ bên cổ, mỗi bên tính một lần", "steps": "Ngồi thẳng, hai vai thả lỏng\nNghiêng đầu, tai hướng về vai, không nhún vai lên\nGiữ 5 giây, về giữa rồi đổi bên", "tip": "Không dùng tay kéo đầu.", "published": true, "sort_order": 2}, {"id": "e3", "name": "Quay cổ", "fig": "turn", "reps": 5, "hold": 3, "sub": "Giúp cổ quay dễ hơn", "steps": "Ngồi thẳng, nhìn thẳng phía trước\nTừ từ quay đầu sang phải đến mức thoải mái\nGiữ 3 giây, về giữa rồi quay sang trái", "tip": "Quay chậm, không giật mạnh.", "published": true, "sort_order": 3}, {"id": "e4", "name": "Xoay vai", "fig": "roll", "reps": 5, "hold": 0, "sub": "Làm ấm và thả lỏng vai", "steps": "Ngồi hoặc đứng thẳng, hai tay buông thõng\nNhấc hai vai lên cao, kéo ra sau rồi hạ xuống thành một vòng tròn lớn\nLàm chậm 5 vòng, rồi đổi chiều", "tip": "Thở đều, không nín thở.", "published": true, "sort_order": 4}, {"id": "e5", "name": "Ép bả vai", "fig": "squeeze", "reps": 5, "hold": 5, "sub": "Mở ngực, giảm gù lưng", "steps": "Ngồi thẳng, hai tay để xuôi\nKéo hai bả vai về phía sau, như kẹp một cây bút giữa hai bả vai\nGiữ 5 giây rồi thả lỏng", "tip": "Không ưỡn lưng quá mức.", "published": true, "sort_order": 5}, {"id": "e6", "name": "Xoay người nhẹ khi ngồi ghế", "fig": "twist", "reps": 5, "hold": 3, "sub": "Giúp lưng linh hoạt", "steps": "Ngồi thẳng trên ghế vững, hai chân đặt sát sàn\nTừ từ xoay thân sang phải, tay phải chạm lưng ghế\nGiữ 3 giây, về giữa rồi xoay sang trái", "tip": "Xoay bằng cả thân người, không vặn cổ.", "published": true, "sort_order": 6}], "Tips": [{"id": "1", "content": "Ngồi lâu thì cứ 45 đến 60 phút đứng dậy đi lại một chút.", "sort_order": 1}, {"id": "2", "content": "Màn hình điện thoại nên ngang tầm mắt, đừng cúi cổ nhìn xuống.", "sort_order": 2}, {"id": "3", "content": "Đo huyết áp lúc ngồi nghỉ 5 phút, tay đặt ngang tim.", "sort_order": 3}, {"id": "4", "content": "Nằm giường vừa cứng, tránh nệm quá mềm hoặc võng.", "sort_order": 4}, {"id": "5", "content": "Đứng dậy từ từ khi vừa nằm hoặc ngồi lâu, để khỏi choáng.", "sort_order": 5}, {"id": "6", "content": "Khi nhấc đồ: gập gối, giữ lưng thẳng, ôm đồ sát người.", "sort_order": 6}], "Texts": [{"id": "text-1", "original": "Cổ", "value": "Cổ"}, {"id": "text-2", "original": "Ngực", "value": "Ngực"}, {"id": "text-3", "original": "Thắt lưng", "value": "Thắt lưng"}, {"id": "text-4", "original": "Cùng cụt", "value": "Cùng cụt"}, {"id": "text-5", "original": "TÂM THU", "value": "TÂM THU"}, {"id": "text-6", "original": "TÂM TRƯƠNG", "value": "TÂM TRƯƠNG"}, {"id": "text-7", "original": "NHỊP TIM / PHÚT", "value": "NHỊP TIM / PHÚT"}, {"id": "text-8", "original": "Cổ vai gáy", "value": "Cổ vai gáy"}, {"id": "text-9", "original": "Chạm vào chấm sáng để xem từng vùng", "value": "Chạm vào chấm sáng để xem từng vùng"}, {"id": "text-10", "original": "Gáy và đốt sống cổ", "value": "Gáy và đốt sống cổ"}, {"id": "text-11", "original": "Phần sau cổ, nơi đầu tựa lên cột sống", "value": "Phần sau cổ, nơi đầu tựa lên cột sống"}, {"id": "text-12", "original": "Các cơ sau gáy giữ đầu thẳng. Khi cúi nhìn điện thoại, ngồi gù hoặc gặp lạnh đột ngột, các cơ này co cứng và gây đau.", "value": "Các cơ sau gáy giữ đầu thẳng. Khi cúi nhìn điện thoại, ngồi gù hoặc gặp lạnh đột ngột, các cơ này co cứng và gây đau."}, {"id": "text-13", "original": "Cứng cổ, khó quay đầu, nhất là buổi sáng", "value": "Cứng cổ, khó quay đầu, nhất là buổi sáng"}, {"id": "text-14", "original": "Mỏi gáy, nặng đầu", "value": "Mỏi gáy, nặng đầu"}, {"id": "text-15", "original": "Đôi khi chóng mặt hoặc đau đầu kèm theo", "value": "Đôi khi chóng mặt hoặc đau đầu kèm theo"}, {"id": "text-16", "original": "Chườm ấm vùng gáy, lót khăn mỏng để tránh bỏng", "value": "Chườm ấm vùng gáy, lót khăn mỏng để tránh bỏng"}, {"id": "text-17", "original": "Tập gập, nghiêng, quay cổ thật chậm trong mức không đau", "value": "Tập gập, nghiêng, quay cổ thật chậm trong mức không đau"}, {"id": "text-18", "original": "Chỉnh gối cao vừa phải, không quá cao", "value": "Chỉnh gối cao vừa phải, không quá cao"}, {"id": "text-19", "original": "Đau gáy kèm chóng mặt, buồn nôn kéo dài", "value": "Đau gáy kèm chóng mặt, buồn nôn kéo dài"}, {"id": "text-20", "original": "Đau gáy kèm đau ngực hoặc khó thở: gọi 115 ngay", "value": "Đau gáy kèm đau ngực hoặc khó thở: gọi 115 ngay"}, {"id": "text-21", "original": "Đau sau khi bị ngã hoặc va chạm mạnh", "value": "Đau sau khi bị ngã hoặc va chạm mạnh"}, {"id": "text-22", "original": "Cơ vai", "value": "Cơ vai"}, {"id": "text-23", "original": "Cơ thang, từ gáy xuống hai bên vai", "value": "Cơ thang, từ gáy xuống hai bên vai"}, {"id": "text-24", "original": "Hai bên vai gánh sức nặng của tay và đầu. Căng thẳng, ngồi lâu hay mang xách nặng làm cơ vai căng cứng.", "value": "Hai bên vai gánh sức nặng của tay và đầu. Căng thẳng, ngồi lâu hay mang xách nặng làm cơ vai căng cứng."}, {"id": "text-25", "original": "Vai nặng, mỏi như đeo vật nặng", "value": "Vai nặng, mỏi như đeo vật nặng"}, {"id": "text-26", "original": "Đau khi giơ tay lên cao", "value": "Đau khi giơ tay lên cao"}, {"id": "text-27", "original": "Căng cứng nhiều hơn khi lo lắng", "value": "Căng cứng nhiều hơn khi lo lắng"}, {"id": "text-28", "original": "Xoay vai chậm theo vòng tròn", "value": "Xoay vai chậm theo vòng tròn"}, {"id": "text-29", "original": "Thở chậm, hạ hai vai xuống thả lỏng", "value": "Thở chậm, hạ hai vai xuống thả lỏng"}, {"id": "text-30", "original": "Đổi bên khi xách đồ, không xách quá nặng", "value": "Đổi bên khi xách đồ, không xách quá nặng"}, {"id": "text-31", "original": "Đau vai tăng dần dù đã nghỉ", "value": "Đau vai tăng dần dù đã nghỉ"}, {"id": "text-32", "original": "Không giơ nổi tay lên", "value": "Không giơ nổi tay lên"}, {"id": "text-33", "original": "Đau vai trái lan ngực, ra hàm: gọi 115", "value": "Đau vai trái lan ngực, ra hàm: gọi 115"}, {"id": "text-34", "original": "Bả vai và lưng trên", "value": "Bả vai và lưng trên"}, {"id": "text-35", "original": "Hai xương bả vai, hai bên cột sống ngực", "value": "Hai xương bả vai, hai bên cột sống ngực"}, {"id": "text-36", "original": "Ngồi gù lưng khiến hai bả vai bị kéo ra trước, các cơ giữa lưng bị kéo giãn và mỏi.", "value": "Ngồi gù lưng khiến hai bả vai bị kéo ra trước, các cơ giữa lưng bị kéo giãn và mỏi."}, {"id": "text-37", "original": "Mỏi giữa hai bả vai", "value": "Mỏi giữa hai bả vai"}, {"id": "text-38", "original": "Lưng trên nặng, khó ngồi thẳng lâu", "value": "Lưng trên nặng, khó ngồi thẳng lâu"}, {"id": "text-39", "original": "Bài ép bả vai: kéo hai bả vai về phía sau rồi thả", "value": "Bài ép bả vai: kéo hai bả vai về phía sau rồi thả"}, {"id": "text-40", "original": "Ngồi sát lưng ghế, tựa thẳng", "value": "Ngồi sát lưng ghế, tựa thẳng"}, {"id": "text-41", "original": "Đứng dậy đi lại mỗi 45 đến 60 phút", "value": "Đứng dậy đi lại mỗi 45 đến 60 phút"}, {"id": "text-42", "original": "Đau kèm tức ngực, khó thở", "value": "Đau kèm tức ngực, khó thở"}, {"id": "text-43", "original": "Đau về đêm, tăng dần, kèm sốt hoặc sụt cân", "value": "Đau về đêm, tăng dần, kèm sốt hoặc sụt cân"}, {"id": "text-44", "original": "Cánh tay và bàn tay", "value": "Cánh tay và bàn tay"}, {"id": "text-45", "original": "Nơi cơn tê có thể lan xuống", "value": "Nơi cơn tê có thể lan xuống"}, {"id": "text-46", "original": "Khi đĩa đệm hoặc gai xương ở cổ chèn vào dây thần kinh, cảm giác tê hoặc đau có thể lan từ cổ xuống vai, cánh tay và các ngón tay.", "value": "Khi đĩa đệm hoặc gai xương ở cổ chèn vào dây thần kinh, cảm giác tê hoặc đau có thể lan từ cổ xuống vai, cánh tay và các ngón tay."}, {"id": "text-47", "original": "Tê bì, kiến bò ở cánh tay hoặc ngón tay", "value": "Tê bì, kiến bò ở cánh tay hoặc ngón tay"}, {"id": "text-48", "original": "Tay yếu, cầm đồ dễ rơi", "value": "Tay yếu, cầm đồ dễ rơi"}, {"id": "text-49", "original": "Đau lan từ cổ xuống tay", "value": "Đau lan từ cổ xuống tay"}, {"id": "text-50", "original": "Ghi lại vị trí tê và thời điểm xuất hiện", "value": "Ghi lại vị trí tê và thời điểm xuất hiện"}, {"id": "text-51", "original": "Tránh ngủ tư thế đè lên tay", "value": "Tránh ngủ tư thế đè lên tay"}, {"id": "text-52", "original": "Báo bác sĩ để được kiểm tra thần kinh", "value": "Báo bác sĩ để được kiểm tra thần kinh"}, {"id": "text-53", "original": "Tê yếu tay kéo dài vài ngày", "value": "Tê yếu tay kéo dài vài ngày"}, {"id": "text-54", "original": "Tay yếu đột ngột một bên, kèm méo miệng hoặc nói khó: gọi 115", "value": "Tay yếu đột ngột một bên, kèm méo miệng hoặc 
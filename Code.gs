/** Run setup() ONCE from a standalone project at script.google.com.
 * Creates a Google Sheet owned by the executing administrator.
 * Only public editorial data is returned. Never put patient data in this Sheet.
 */
const TABLE_HEADERS = {
 Settings:['key','value'],
 Articles:['id','title','icon','minutes','cover_url','cover_alt','urgent','published','sort_order'],
 ArticleBlocks:['id','article_id','heading','type','content','sort_order'],
 Products:['id','name','price','currency','image_url','video_url','buy_url','description','published','sort_order'],
 Topics:['id','name','icon','data_json','sort_order'],
 Exercises:['id','name','fig','reps','hold','sub','steps','tip','published','sort_order'],
 Tips:['id','content','sort_order'],
 Texts:['id','original','value']
};
function setup(){
 const properties=PropertiesService.getScriptProperties();
 if(properties.getProperty('SPREADSHEET_ID')){console.log('Đã cấu hình: https://docs.google.com/spreadsheets/d/'+properties.getProperty('SPREADSHEET_ID'));return;}
 const ss=SpreadsheetApp.create('An Cột Sống — Quản trị nội dung');
 properties.setProperty('SPREADSHEET_ID',ss.getId());
 Object.keys(TABLE_HEADERS).forEach(name=>{
  const sh=ss.insertSheet(name),headers=name==='Products'?TABLE_HEADERS[name].concat(['button_label','button_class','video_button_label','video_button_class','display_layout','badge_label','gallery_urls']):TABLE_HEADERS[name],rows=INITIAL_DATA[name]||[];
  sh.getRange(1,1,1,headers.length).setValues([headers]).setBackground('#2B5675').setFontColor('#ffffff').setFontWeight('bold');
  if(rows.length)sh.getRange(2,1,rows.length,headers.length).setValues(rows.map(r=>headers.map(k=>r[k]===undefined?'':r[k])));
  sh.setFrozenRows(1);sh.getDataRange().setWrap(true).setVerticalAlignment('top');sh.setColumnWidths(1,headers.length,180);
  ['content','value','data_json','description','steps'].forEach(k=>{const i=headers.indexOf(k);if(i>=0)sh.setColumnWidth(i+1,420);});
  ['published','urgent'].forEach(k=>{const i=headers.indexOf(k);if(i>=0)sh.getRange(2,i+1,Math.max(1000,rows.length),1).setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());});
  const type=headers.indexOf('type');if(type>=0)sh.getRange(2,type+1,1000,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['paragraph','list'],true).setAllowInvalid(false).build());
 });
 const initial=ss.getSheets()[0];if(!TABLE_HEADERS[initial.getName()])ss.deleteSheet(initial);
 const guide=ss.insertSheet('HUONG_DAN');guide.getRange(1,1,9,2).setValues([
 ['Bảng','Cách sử dụng'],['Articles','Một dòng mỗi bài. ID duy nhất, published TRUE để hiện.'],
 ['ArticleBlocks','Các đoạn của bài: article_id liên kết Articles.id. type paragraph hoặc list; mỗi dòng xuống hàng là một mục list. Chèn [[product:goi-mau]] trong content.'],
 ['Products','Một dòng mỗi sản phẩm. ID duy nhất; giá dạng số, currency VND. URL ảnh/video/mua hàng dùng https. published TRUE để hiện.'],
 ['Settings','Tên ứng dụng, khẩu hiệu, lời nhắc và an toàn bài tập.'],['Texts','Sửa cột value để đổi chữ giao diện. Giữ nguyên original và id.'],
 ['Topics','Chuyên đề khám phá. Giữ các ID spine, neck, joint, bp. Sửa nội dung data_json theo cấu trúc sẵn có.'],
 ['Exercises / Tips','Bài tập và mẹo hằng ngày; steps xuống dòng, reps và hold là số.'],
 ['Đồng bộ','Frontend đọc Sheet mỗi 15 giây khi trang đang mở. Không đưa thông tin cá nhân, số đo hay thuốc của người dùng vào Sheet.']
 ]);guide.setColumnWidth(1,180);guide.setColumnWidth(2,900);guide.getDataRange().setWrap(true);guide.setFrozenRows(1);
 console.log('GOOGLE SHEET: '+ss.getUrl());
}
function doGet(e){
 const callback=e&&e.parameter&&e.parameter.callback;
 if(callback&&!/^acsCMS_[0-9]+$/.test(callback))return ContentService.createTextOutput('{"error":"Invalid callback"}').setMimeType(ContentService.MimeType.JSON);
 let payload;
 try{
  const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('Chạy setup() trước');
  const ss=SpreadsheetApp.openById(id),tables={};
  Object.keys(TABLE_HEADERS).forEach(name => {
    const sh = ss.getSheetByName(name);
    if (!sh) throw Error('Thiếu bảng ' + name);
    const values = sh.getDataRange().getValues();
    const headers = values.shift().map(v => String(v).trim());
    const required = TABLE_HEADERS[name];
    const columns = name === 'Products' ? required.concat(['button_label','button_class','video_button_label','video_button_class','display_layout','badge_label','gallery_urls']) : required;
    required.forEach(k => {
      if (!headers.includes(k)) throw Error('Thiếu cột ' + name + '.' + k);
    });
    const key = name === 'Settings' ? 'key' : 'id';
    const seen = new Map();
    tables[name] = [];
    values.forEach((row, index) => {
      const r = {};
      columns.forEach(k => {
        const pos = headers.indexOf(k);
        const v = pos < 0 ? '' : row[pos];
        r[k] = v instanceof Date ? v.toISOString() : v;
      });
      // Bỏ dòng trống, kể cả dòng chỉ có checkbox FALSE.
      const hasContent = columns.some(k => {
        if (k === 'published' || k === 'urgent') return false;
        return String(r[k] == null ? '' : r[k]).trim() !== '';
      });
      if (!hasContent) {
        if ([r.published, r.urgent].some(v => String(v).trim().toLowerCase() === 'true')) {
          throw Error(name + ': dòng ' + (index + 2) + ' bật TRUE nhưng thiếu ' + key);
        }
        return;
      }
      const code = String(r[key] == null ? '' : r[key]).trim();
      const line = index + 2;
      if (!code) throw Error(name + ': dòng ' + line + ' thiếu ' + key);
      if (seen.has(code)) {
        throw Error(name + ': dòng ' + line + ' trùng mã "' + code + '" với dòng ' + seen.get(code));
      }
      seen.set(code, line);
      r[key] = code;
      if (name === 'ArticleBlocks') r.article_id = String(r.article_id || '').trim();
      tables[name].push(r);
    });
  });
  // Draft articles/products/exercises are not exposed by the public endpoint.
  const visible=v=>v===true||String(v).toLowerCase()==='true';
  tables.Articles=tables.Articles.filter(r=>visible(r.published));
  const articleIDs=new Set(tables.Articles.map(r=>r.id));tables.ArticleBlocks=tables.ArticleBlocks.filter(r=>articleIDs.has(r.article_id));
  tables.Products=tables.Products.filter(r=>visible(r.published));tables.Exercises=tables.Exercises.filter(r=>visible(r.published));
  const serialized=JSON.stringify(tables);
  const version=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,serialized));
  payload={schema:1,version:version,tables:tables};
 }catch(err){console.error(err);payload={error:'Không đọc được nội dung. Kiểm tra cấu hình và các bảng trong Sheet.'};}
 const json=JSON.stringify(payload).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
 return ContentService.createTextOutput(callback?callback+'('+json+');':json).setMimeType(callback?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON);
}

/** Run once to add optional fields to the EXISTING Sheet; safe to run again.
 * Never recreates the Sheet and never overwrites existing content.
 */
function upgradeSheet(){
 const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
 if(!id)throw Error('Cấu hình SPREADSHEET_ID trước');
 const ss=SpreadsheetApp.openById(id);
 const products=ss.getSheetByName('Products');
 const settings=ss.getSheetByName('Settings');
 if(!products||!settings)throw Error('Cần bảng Products và Settings');
 const headers=products.getRange(1,1,1,products.getLastColumn()).getValues()[0].map(v=>String(v).trim());
 ['button_label','button_class','video_button_label','video_button_class','display_layout','badge_label','gallery_urls'].forEach(name=>{
  if(headers.includes(name))return;
  const col=products.getLastColumn()+1;
  if(col>products.getMaxColumns())products.insertColumnAfter(products.getMaxColumns());
  products.getRange(1,col).setValue(name).setBackground('#2B5675').setFontColor('#ffffff').setFontWeight('bold');
  products.setColumnWidth(col,200);headers.push(name);
 });
 const settingsHeaders=settings.getRange(1,1,1,settings.getLastColumn()).getValues()[0].map(v=>String(v).trim());
 const keyColumn=settingsHeaders.indexOf('key'),valueColumn=settingsHeaders.indexOf('value');
 if(keyColumn<0||valueColumn<0)throw Error('Settings cần cột key và value');
 const keys=settings.getDataRange().getValues().slice(1).map(row=>String(row[keyColumn]).trim());
 [['custom_css',''],['custom_js',''],['custom_js_enabled','FALSE'],["model_spine_url", ""],["model_neck_url", ""],["model_joint_url", ""],["model_bp_url", ""],["heart_point_1", "Tâm nhĩ: nhận máu trở về tim, rồi chuyển xuống tâm thất."],["heart_point_2", "Tâm thất: bơm máu ra khỏi tim; thất phải tới phổi, thất trái tới cơ thể."],["heart_point_3", "Động mạch chủ: đưa máu từ thất trái tới cơ thể. Huyết áp là áp lực của máu lên thành động mạch."],["heart_point_4", "Động mạch vành: cung cấp máu cho cơ tim."],["push_api_url", "/push-api"],["product_intro_label", "Sản phẩm tham khảo"],["announcement_data", ""]].forEach(([key,value])=>{
  if(keys.includes(key))return;
  const row=Array(settings.getLastColumn()).fill('');row[keyColumn]=key;row[valueColumn]=value;settings.appendRow(row);keys.push(key);
 });
 console.log('Đã bổ sung button_label, button_class, các tùy chọn sản phẩm và thông báo hệ thống. '+ss.getUrl());
}

